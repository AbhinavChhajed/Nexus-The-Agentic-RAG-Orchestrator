# ── Required ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here

# ── LLM (optional — defaults shown) ─────────────────────────────────────
# LLM_MODEL_NAME=gemini-3.7-flash
# LLM_TEMPERATURE=0.0

# ── Embeddings (optional) ───────────────────────────────────────────────
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── RAG (optional) ──────────────────────────────────────────────────────
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# RETRIEVER_TOP_K=2

# ── Persistence (optional) ──────────────────────────────────────────────
# MEMORY_DB_PATH=nexus_memory.db
# TITLE_DB_PATH=nexus.db

# ── Server (optional) ───────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# UPLOAD_DIR=uploads

# ── CORS (optional — comma-separated origins) ───────────────────────────
# CORS_ORIGINS=["*"]
